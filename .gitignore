# Runtime state - never commit
game/state.json
game/cost.jsonl*
game/outbox/*
!game/outbox/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
*.swp

# Cortex Code session/plan metadata, not project code
.snowflake/

# Playwright persona-audit runtime. package.json and playwright.config.js ARE
# committed so another SE can run the suite; the installed tree and the run
# output are not.
node_modules/
test-results/
playwright-report/
.playwright/

# Persona-audit screenshots are run output, not source.
audit/audit/shots/
audit/shots/

# Playwright run output (absolute paths, not source)
audit/results.json

# Generated and internal-only, kept on disk but not shipped. The repo should be
# what another SE needs to RUN the booth, not the record of how it was built.
# Regenerate with: build_se_review_html.py / audit_marketplace_regions.py.
audit/marketplace-se-review.html
audit/marketplace-region-audit.json

# Working records of decisions. Their history lives in git log and in the private
# notes repo, not in the shipped tree.
audit/weak-fit-review.md
audit/setup-doc-changes.md
audit/personas.md
notes/

# Never commit private keys or connection files, even if one is generated inside
# the repo directory by mistake. Key-pair setup writes to ~/.snowflake/keys, so
# these should never appear here - this is defence in depth, not the normal path.
*.p8
*.pem
*.key
connections.toml
# Locally generated visitor takeaways. Blueprints live on a Snowflake stage; a
# stray .docx in the tree would be visitor content that must not ship.
*.docx
# Runtime outbox (email was removed). Keep the directory, ignore any contents.
game/outbox/*
!game/outbox/.gitkeep

# snow streamlit deploy bundle
operator_app/output/
operator_app/snowflake.yml
